{
  "compilerOptions": {
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "paths": {
      "spve": ["./packages/spve/index.d.ts"],
      "spve/*": ["./packages/spve/*.d.ts"]
    },
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["vite.config.ts", "packages/**/*.d.ts"],
  "exclude": ["packages/create-spve/templates", "packages/spve/template"]
}
